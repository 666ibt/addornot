# Скопируйте в .env и подставьте значения из Supabase -> Project Settings -> API.
#
#   cp .env.example .env
#
# Префикс EXPO_PUBLIC_ обязателен: только такие переменные попадают в клиент.
# Здесь нужен именно anon-ключ — service_role в приложение класть нельзя.
EXPO_PUBLIC_SUPABASE_URL=https://ВАШ_ПРОЕКТ.supabase.co
EXPO_PUBLIC_SUPABASE_ANON_KEY=ВАШ_ANON_КЛЮЧ
