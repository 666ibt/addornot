{
  "expo": {
    "name": "MusicSwipe",
    "slug": "musicswipe",
    "version": "1.0.0",
    "orientation": "portrait",
    "scheme": "musicswipe",
    "userInterfaceStyle": "dark",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.musicswipe.app"
    },
    "android": {
      "package": "com.musicswipe.app",
      "edgeToEdgeEnabled": true
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-audio",
        {
          "microphonePermission": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
