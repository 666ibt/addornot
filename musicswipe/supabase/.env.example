# Секреты Edge Functions.
#
# Локально:  supabase start && supabase functions serve --env-file supabase/.env
# В облаке:  supabase secrets set --env-file supabase/.env
#
# SUPABASE_URL и SUPABASE_SERVICE_ROLE_KEY подставляются платформой
# автоматически — их сюда добавлять не нужно.

# --- Ничего из этого не обязательно -----------------------------------------
# Deezer работает без ключей, и на нём держится каталог, превью и рекомендации.
# Ключи ниже нужны только для надёжного чтения плейлистов с конкретных платформ:
# без них используется разбор публичных страниц, который ломается при
# редизайне сервиса и не видит приватные плейлисты.

# Spotify: https://developer.spotify.com/dashboard (Client ID / Client Secret)
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Apple Music: JWT, подписанный ключом MusicKit (Apple Developer -> Keys)
APPLE_MUSIC_DEVELOPER_TOKEN=

# YouTube Data API v3: https://console.cloud.google.com/apis/credentials
YOUTUBE_API_KEY=

# SoundCloud: client_id веб-плеера (иначе достаём его со страницы автоматически)
SOUNDCLOUD_CLIENT_ID=
