# Скопируй этот файл в .env и впиши свои значения.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# ID администратора(ов) через запятую — кому доступна команда /today.
# Свой Telegram ID можно узнать у бота @userinfobot.
ADMIN_IDS=123456789

# Во сколько (по этому часовому поясу) отправлять ежедневную рассылку
DAILY_HOUR=9
DAILY_MINUTE=0
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных (по умолчанию vis.db рядом с ботом)
DB_PATH=vis.db

# Папка с файлами контента (news.json, books.json, persons.json)
DATA_DIR=data

# Источник новостей: rss (бот сам тянет из лент) или file (берёт из news.json).
NEWS_MODE=rss

# RSS-ленты для новостей (через запятую). Бери разделы «мир/международное».
NEWS_RSS_FEEDS=https://feeds.bbci.co.uk/russian/rss.xml,https://tass.ru/rss/v2.xml
