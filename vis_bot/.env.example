# Скопируй этот файл в .env и впиши свои значения.

# Токен Telegram-бота от @BotFather
BOT_TOKEN=123456:ABC-DEF...

# Ключ Anthropic API (https://console.anthropic.com/)
ANTHROPIC_API_KEY=sk-ant-...

# Во сколько (по этому часовому поясу) отправлять ежедневную рассылку
DAILY_HOUR=9
DAILY_MINUTE=0
TIMEZONE=Europe/Moscow

# Путь к файлу базы данных (по умолчанию vis.db рядом с ботом)
DB_PATH=vis.db

# YouTube-каналы для заметок о личности (Минаев Live и т.п.).
# Указываются ID каналов (UC...), через запятую. Можно оставить пустым —
# тогда заметка строится только по веб-поиску.
# Как узнать ID канала: открыть канал → «Поделиться» → «Скопировать ID канала».
# Пример: YOUTUBE_CHANNEL_IDS=UCxxxxxxxxxxxxxxxxxxxxxx,UCyyyyyyyyyyyyyyyyyyyyyy
YOUTUBE_CHANNEL_IDS=
